local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ChatEvent = ReplicatedStorage:FindFirstChild("SayMessageRequest", true)

if ChatEvent then
    game:GetService("Players").LocalPlayer.Chatted:Connect(function(msg)
        
        if msg:sub(1, 3) == "HTP" then
            
            local formattedMessage = ""
            
            if msg:sub(1, 4) == "HTP " then
                local content = msg:sub(5)
                formattedMessage = '<font size="30" color="rgb(0,0,0)"><stroke color="rgb(204,0,0)" thickness="3.5"><b>[HTP]: '..content..'</b></stroke></font>'
            
            elseif msg:sub(1, 5) == "HTP1 " then
                local content = msg:sub(6)
                formattedMessage = '<font size="30" color="rgb(255,255,255)"><stroke color="rgb(0,100,255)" thickness="3.5"><b>[HTP-BLUE]: '..content..'</b></stroke></font>'
            
            elseif msg:sub(1, 5) == "HTP2 " then
                local content = msg:sub(6)
                formattedMessage = '<font size="30" color="rgb(0,0,0)"><stroke color="rgb(0,255,100)" thickness="3.5"><b>[HTP-GREEN]: '..content..'</b></stroke></font>'
            
            elseif msg:sub(1, 5) == "HTP3 " then
                local content = msg:sub(6)
                formattedMessage = '<font size="30" color="rgb(255,215,0)"><stroke color="rgb(40,40,40)" thickness="3.5"><b>[HTP-GOLD]: '..content..'</b></stroke></font>'
            
            elseif msg:sub(1, 5) == "HTP4 " then
                local content = msg:sub(6)
                formattedMessage = '<font size="30" color="rgb(255,255,255)"><stroke color="rgb(150,0,255)" thickness="3.5"><b>[HTP-VIP]: '..content..'</b></stroke></font>'
            end
            
            if formattedMessage ~= "" then
                ChatEvent:FireServer(formattedMessage, "All")
            end
            
        end
    end)
    
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "HTP SYSTEM v2",
        Text = "System Activated Successfully!",
        Duration = 5
    })
end
